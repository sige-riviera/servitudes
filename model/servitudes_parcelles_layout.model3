          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="CASE&#xd;&#xa;  WHEN @commune = 0 THEN &quot;noofs&quot; = 5881&#xd;&#xa;  WHEN @commune = 1 THEN &quot;noofs&quot; = 5882&#xd;&#xa;  WHEN @commune = 2 THEN &quot;noofs&quot; = 5883&#xd;&#xa;  WHEN @commune = 3 THEN &quot;noofs&quot; = 5884&#xd;&#xa;  WHEN @commune = 4 THEN &quot;noofs&quot; = 5885&#xd;&#xa;  WHEN @commune = 5 THEN &quot;noofs&quot; = 5889&#xd;&#xa;  WHEN @commune = 6 THEN &quot;noofs&quot; = 5886&#xd;&#xa;  WHEN @commune = 7 THEN &quot;noofs&quot; = 5408&#xd;&#xa;  WHEN @commune = 8 THEN &quot;noofs&quot; = 6154&#xd;&#xa;  WHEN @commune = 9 THEN &quot;noofs&quot; = 5888&#xd;&#xa;  WHEN @commune = 10 THEN &quot;noofs&quot; = 5891&#xd;&#xa;  WHEN @commune = 11 THEN &quot;noofs&quot; = 5890&#xd;&#xa;  WHEN @commune = 12 THEN &quot;noofs&quot; = 5414&#xd;&#xa;  ELSE false&#xd;&#xa;END&#xd;&#xa;" type="QString" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
